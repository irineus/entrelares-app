<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Release builds carry NO permissions from the debug/profile overlays —
         without this line the app cannot reach the network at all, and the
         symptom is a misleading "Failed host lookup / errno = 7" (F-58 QA,
         pilot lesson 2.1). -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- F-09: Android 13+ makes notifications a RUNTIME permission, with the
         same "denied is expensive" economics the web prompt had — the OS shows
         the dialog once and a refusal is only reversible in Settings. The app
         therefore never asks on load: the request rides a gesture, after the
         person has a reason to want it. Below 33 the grant is implicit, which
         is why the flow must read the real permission state and not assume. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <application
        android:label="${appName}"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- App Links (lote 1): the recovery e-mail's link opens the app
                 directly. autoVerify requires web.entrelares.app (the PWA
                 origin) to serve .well-known/assetlinks.json naming this
                 applicationId + signing cert — prod is already listed there
                 since F-54; the dev statement (T-55 sideload cert) ships in
                 the paired entrelares-app PR. Until verified — and on debug
                 builds, whose per-machine cert is never listed — Android
                 falls back to the browser, where the PWA serves the same
                 page, so nothing breaks.

                 /register joined in lote 4: an invitation link opens the
                 sign-up form with the token already in hand. It carries a
                 QUERY (?invite=…) and no path pattern is needed for that —
                 Android matches on the path alone and hands the full URI to
                 the app, where the router keeps the query. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https"
                      android:host="web.entrelares.app"
                      android:path="/update-password"/>
                <data android:scheme="https"
                      android:host="web.entrelares.app"
                      android:path="/register"/>
            </intent-filter>
            <!-- F-57: the OAuth redirect's way back. A custom scheme, per
                 FLAVOR — the scheme IS the applicationId, via the built-in
                 placeholder, so a device carrying both flavors never opens a
                 chooser (and never hands dev's PKCE code to prod). An https
                 App Link would depend on the custom tab's redirect handoff,
                 which is the flaky half of Android deep linking; a scheme
                 filter has no verification step to lose. The matching
                 DeepLinkUrls.oauthCallback builds the same value from
                 Env.androidPackage, and each Supabase project's Redirect URLs
                 allowlist carries its flavor's (runbook §9-ter). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="${applicationId}"
                      android:host="login-callback"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <!-- F-09 — the status-bar icon, and it is NOT a nicety. Android renders a
             notification's small icon as a SILHOUETTE: it keeps the alpha channel
             and throws the colours away. With no icon declared the SDK falls back
             to the launcher icon, which flattens into a featureless white blob —
             exactly what a real device showed on the first push (29/08/2026).
             `ic_stat_entrelares` is a white-on-transparent glyph generated from
             the same geometry as every other icon (`store/brand-icons.py`). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_entrelares" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent" />
        <!-- F-09: the channel the push payload names. If the id does not exist
             on the device, Android 8+ drops the notification WITHOUT an error —
             the send succeeds, FCM reports delivery and nothing appears. The
             channel itself is created in MainActivity; this entry is the
             fallback the SDK uses for any message that names none. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="entrelares_swaps" />
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
