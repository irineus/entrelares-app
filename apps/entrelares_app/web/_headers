# ═══════════════════════════════════════════════════════════════════════════════
# Security headers — apply to all routes
# ═══════════════════════════════════════════════════════════════════════════════
# Ported from the Blazor PWA's own `_headers` (T-53 stage 4: Flutter Web takes
# over the hostname, so it also takes over the promises the hostname made).
# The CSP is NOT a copy — the engine is different:
#   * `wasm-unsafe-eval` + `blob:` in script-src/worker-src: CanvasKit compiles
#     WebAssembly and Flutter spawns workers from blob URLs.
#   * `'unsafe-eval'` is NOT here — Blazor WASM needed it, CanvasKit does not.
#   * canvaskit is served from THIS origin (the deploy builds with
#     `--no-web-resources-cdn`) — no third-party SCRIPT source, ever.
#   * `fonts.gstatic.com` in connect-src/font-src is NOT decoration: CanvasKit
#     draws text itself, so a glyph the embedded Inter does not cover (the
#     subset is `latin`, U-27) makes the engine FETCH a fallback font — Roboto
#     and Noto Sans Symbols. Blocked, the product's own emoji vocabulary
#     (🔔 ⏳ 🛡️ 🗑️ 📄) renders as tofu on the web channel; Android never sees
#     this because the glyph comes from the system font. Owner decision
#     (23/08/2026): allow the host — which makes Google an operator for the web
#     client, declared in the privacy policy. It is fetched with `fetch`, so
#     `connect-src` is the directive that actually rules; `font-src` is there
#     for the CSS path.
#   * T-62 adds TWO connect-src hosts and NOTHING to script-src, which is the
#     whole shape of that item: `firebase_core_web` fetches the Firebase JS SDK
#     from gstatic by dynamic `import()`, and this CSP forbids executable code
#     from anywhere but this origin — so the SDK is VENDORED under
#     `/firebasejs/<version>/` instead (`tool/vendor_firebase_js.py`) and the
#     plugin is told to inject nothing. What remains third-party is the API the
#     SDK TALKS to: `firebaseinstallations` mints the installation id and
#     `fcmregistrations` exchanges it for the registration token. Both are
#     `fetch`, from the page AND from the messaging worker (a worker's requests
#     are judged by the CSP served with the worker script, which is this one).
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data: https://fonts.gstatic.com; worker-src 'self' blob:; child-src 'self' blob:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://cloud.umami.is https://fonts.gstatic.com https://firebaseinstallations.googleapis.com https://fcmregistrations.googleapis.com; frame-ancestors 'none'

# ═══════════════════════════════════════════════════════════════════════════════
# Cache control
# ═══════════════════════════════════════════════════════════════════════════════

# The TOMBSTONE of the Blazor service worker, and the reason the cutover
# reaches installed PWAs at all: the browser re-fetches this URL on its update
# check, and it must never come from a cache. See service-worker.js.
/service-worker.js
  Cache-Control: no-cache, no-store, must-revalidate

# Flutter's own service worker and the bootstrap that carries its version. A
# stale copy of either pins the app shell to an old build.
/flutter_service_worker.js
  Cache-Control: no-cache, no-store, must-revalidate

/flutter_bootstrap.js
  Cache-Control: no-cache, no-store, must-revalidate

# T-62 — the FCM worker. Same rule as the two above and for the same reason:
# the browser re-fetches a registered worker to check it for updates, and a
# cached copy pins the push routing (and the Firebase config) to an old build.
/firebase-messaging-sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# The app shell must be fresh so the service worker can always serve the
# correct version.
/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/manifest.json
  Cache-Control: no-cache, no-store, must-revalidate

# T-62 — the vendored Firebase JS SDK. The exact opposite rule of the four
# above, and safely so: the SDK VERSION is in the path, so a given URL's bytes
# never change and a new version is a new URL. Cached hard, it costs a returning
# visitor nothing; the files are only ever fetched by someone who has push on.
/firebasejs/*
  Cache-Control: public, max-age=31536000, immutable

# Digital Asset Links — Android re-reads it to verify App Links. Served as
# JSON, never as a download, and never stale for longer than a day.
/.well-known/assetlinks.json
  Content-Type: application/json
  Cache-Control: public, max-age=3600
