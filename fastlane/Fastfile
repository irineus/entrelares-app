# T-79 — the Android release pipeline, driven from `.github/workflows/verify.yml`.
#
#   merge to main → gates → `play-internal` job:
#       android version_guard  — is the pubspec versionCode new to Play?
#       android beta           — upload the prod AAB to Internal testing
#
#   owner dispatch → approval on `play-production` → `play-promote` workflow:
#       android promote        — Internal → Production, staged; rollout; halt
#
#   pull request that changes the APK → `qa-preview` job:
#       android preview        — dev APK → Firebase App Distribution
#
#   owner dispatch → approval on `play-production` → `play-listing` workflow (T-98):
#       android listing        — store/listing-*.txt (+ phone screenshots) → the
#                                Main store listing, never pasted in the Console
#
# Lanes are named per platform with the SAME names (`beta`, `promote`), so T-40
# adds `ios beta` (TestFlight internal) and `ios promote` (App Store phased
# release) beside these and the workflow only switches the platform.
#
# Run from the repository root (`bundle exec fastlane android <lane>`); every
# path below is resolved against it, never against the caller's cwd.

# No usage metrics leave the runner: nothing this pipeline does is fastlane's
# business, and it costs nothing to say so.
opt_out_usage

default_platform(:android)

PLAY_PACKAGE = "com.entrelares.app"

# The dev flavour's Firebase Android app (`com.entrelares.flutter` in project
# `entrelares-dev`) — PUBLIC, it ships inside every dev APK's
# google-services.json, and `play_release_test` pins the two together.
FIREBASE_DEV_ANDROID_APP = "1:51960618124:android:88c998a8647c0d471dafa9"
# The App Distribution tester group, by ALIAS (created once in the console).
QA_TESTER_GROUP = "qa"

# Every track a versionCode can already live on. Internal is the ONE testing
# track (owner, 22/09/2026); alpha/beta stay in the list because the Closed
# testing – Alpha track carried every bundle up to 2.6.x, and a code already
# used there is used for good — Play refuses a repeat on any track.
PLAY_TRACKS = %w[internal alpha beta production].freeze

# The release service account, as an Environment secret. A DEDICATED account
# with release permissions on this package only — not `PLAY_SERVICE_ACCOUNT`,
# the billing one the Edge Functions use (owner, 22/09/2026): revoking one must
# not take the other down, and a runner compromise must not read finances.
def play_key
  data = ENV["PLAY_RELEASE_SERVICE_ACCOUNT"].to_s
  if data.strip.empty?
    UI.user_error!(
      "PLAY_RELEASE_SERVICE_ACCOUNT is empty — the job should have disarmed " \
      "before reaching fastlane (see the `play-internal` job)."
    )
  end
  data
end

# One line in the run summary AND in the log. PT-BR, like the other summaries
# of this workflow: a human reads it at whatever hour it fires.
def summary(line)
  path = ENV["GITHUB_STEP_SUMMARY"].to_s
  File.open(path, "a") { |f| f.puts(line) } unless path.empty?
  UI.message(line)
end

def step_output(key, value)
  path = ENV["GITHUB_OUTPUT"].to_s
  File.open(path, "a") { |f| f.puts("#{key}=#{value}") } unless path.empty?
end

# The release notes of one versionCode, in `store/release-notes/<code>/`, one
# file per Play language. Required at PROMOTION only (owner, 22/09/2026): the
# Internal testers are the owner, and a note per bump would be written for
# nobody. They go in a small PR BEFORE the promotion dispatch, and
# `play_release_test` checks every folder on the way in.
require "fileutils"
require "tmpdir"

RELEASE_NOTES_DIR = File.expand_path("../store/release-notes", __dir__)
RELEASE_NOTE_LANGUAGES = %w[pt-BR en-US].freeze
RELEASE_NOTE_LIMIT = 500 # Play's own limit, per language

# Lays the notes out the way supply reads them —
# `<metadata>/<lang>/changelogs/<code>.txt` — in a scratch folder, so the
# repository keeps the one shape humans edit. Refuses, before anything reaches
# Play, a promotion whose notes are missing, empty or over the limit.
def release_notes_metadata(code)
  source = File.join(RELEASE_NOTES_DIR, code.to_s)
  metadata = Dir.mktmpdir("release-notes-")
  RELEASE_NOTE_LANGUAGES.each do |lang|
    path = File.join(source, "#{lang}.txt")
    unless File.file?(path)
      UI.user_error!(
        "No release notes at store/release-notes/#{code}/#{lang}.txt — write " \
        "both languages in a PR before promoting #{code}."
      )
    end
    text = File.read(path, encoding: "UTF-8").strip
    UI.user_error!("#{path} is empty") if text.empty?
    if text.length > RELEASE_NOTE_LIMIT
      UI.user_error!("#{path} has #{text.length} characters; Play takes #{RELEASE_NOTE_LIMIT}")
    end
    dir = File.join(metadata, lang, "changelogs")
    FileUtils.mkdir_p(dir)
    File.write(File.join(dir, "#{code}.txt"), text)
  end
  metadata
end

# T-98 — the Main store listing, published from `store/` (owner, 02/10/2026):
# the copy is edited in a PR, never in the Console, where nothing is versioned.
#
# The format of `store/listing-<lang>.txt`, read here and by
# `app/test/play_listing_test.dart` with the SAME rules — change one, change
# the other:
#   - a header is a whole line `=== <label> (<= <N> <unit>) ===`;
#   - exactly THREE sections, in this order: app name, short description, full
#     description — position decides the field, and the `<N>` its header
#     declares must be Play's limit for that position (a swap is refused);
#   - a section's text is every line up to the next header, with the leading
#     and trailing whitespace removed (Ruby's `strip`); nothing but blank lines
#     before the first header; name and short description are one line;
#   - length is counted in characters (code points), against Play's limits.
# The file suffix IS the Play locale code: listing-pt-BR.txt → `pt-BR`.
LISTING_DIR = File.expand_path("../store", __dir__)
LISTING_LANGUAGES = %w[pt-BR en-US].freeze
LISTING_HEADER = /\A=== .+ \(<= (\d+) [^)]*\) ===\z/
LISTING_FIELDS = [["title", 30], ["short_description", 80], ["full_description", 4000]].freeze

# Phone screenshots, `store/screenshots/<lang>/phone-<n>.png` (T-97). Play shows
# them in upload order and takes 2 to 8 per language.
SCREENSHOT_DIR = File.expand_path("../store/screenshots", __dir__)
SCREENSHOT_NAME = /\Aphone-([1-9]\d*)\.png\z/
SCREENSHOT_RANGE = (2..8).freeze

# One language's listing, as supply's field names => text. Refuses, before
# anything reaches Play, a file that breaks the format or a limit.
def listing_fields(lang)
  path = File.join(LISTING_DIR, "listing-#{lang}.txt")
  UI.user_error!("No listing at store/listing-#{lang}.txt") unless File.file?(path)
  sections = []
  File.read(path, encoding: "UTF-8").gsub("\r\n", "\n").split("\n", -1).each do |line|
    if (header = LISTING_HEADER.match(line))
      sections << { limit: Integer(header[1], 10), lines: [] }
    elsif sections.empty?
      UI.user_error!("#{path}: text before the first `=== … ===` header") unless line.strip.empty?
    else
      sections.last[:lines] << line
    end
  end
  unless sections.size == LISTING_FIELDS.size
    UI.user_error!("#{path} has #{sections.size} sections; the format has #{LISTING_FIELDS.size}")
  end
  LISTING_FIELDS.each_with_index.to_h do |(field, limit), i|
    text = sections[i][:lines].join("\n").strip
    unless sections[i][:limit] == limit
      UI.user_error!("#{path}: section #{i + 1} declares <= #{sections[i][:limit]}, but #{field} is #{limit} on Play")
    end
    UI.user_error!("#{path}: #{field} is empty") if text.empty?
    if field != "full_description" && text.include?("\n")
      UI.user_error!("#{path}: #{field} must be one line")
    end
    if text.length > limit
      UI.user_error!("#{path}: #{field} has #{text.length} characters; Play takes #{limit}")
    end
    [field, text]
  end
end

# The phone set of one language, in display order — numeric, so phone-10
# follows phone-9. Empty when the folder does not exist: that language's
# screenshots on Play are then left exactly as they are.
def phone_screenshots(lang)
  dir = File.join(SCREENSHOT_DIR, lang)
  return [] unless File.directory?(dir)
  shots = Dir.children(dir).select { |name| name.start_with?("phone-") }.map do |name|
    match = SCREENSHOT_NAME.match(name)
    UI.user_error!("store/screenshots/#{lang}/#{name} is not phone-<n>.png") unless match
    [Integer(match[1], 10), File.join(dir, name)]
  end.sort_by(&:first)
  numbers = shots.map(&:first)
  unless numbers == (1..numbers.size).to_a
    UI.user_error!("store/screenshots/#{lang}/ must number phone-1.png … phone-N.png with no gap — has #{numbers.inspect}")
  end
  unless shots.empty? || SCREENSHOT_RANGE.cover?(shots.size)
    UI.user_error!("store/screenshots/#{lang}/ has #{shots.size} phone screenshots; Play takes #{SCREENSHOT_RANGE.min} to #{SCREENSHOT_RANGE.max}")
  end
  shots.map(&:last)
end

platform :android do
  # Decides whether this merge carries a NEW Android build.
  #
  #   pubspec >  highest on Play → upload=true
  #   pubspec == highest on Play → upload=false, quietly: a server-only or docs
  #                                merge, or a republish dispatch of a commit
  #                                already uploaded — nothing new to send
  #   pubspec <  highest on Play → FAIL, naming both numbers and the track:
  #                                two parallel sessions took the same bump
  #                                (memory: sessoes-paralelas-worktree), or a
  #                                bundle went up by hand. Silently skipping
  #                                would ship a merge that never reaches Android.
  desc "Compare the pubspec versionCode against every Play track"
  lane :version_guard do |options|
    code = Integer(options[:version_code].to_s, 10)

    held = PLAY_TRACKS.to_h do |track|
      codes = google_play_track_version_codes(
        package_name: PLAY_PACKAGE,
        track: track,
        json_key_data: play_key
      )
      [track, codes.max || 0]
    end
    top_track, top = held.max_by { |_, c| c }
    listing = held.map { |t, c| "#{t}=#{c.zero? ? '—' : c}" }.join(", ")

    if code > top
      step_output("upload", "true")
      summary("### Android: versionCode `#{code}` é novo — sobe para a Internal testing")
      summary("Na Play agora: #{listing}.")
    elsif code == top
      step_output("upload", "false")
      summary("### Android: nada a subir — a Play já tem o versionCode `#{code}` (faixa `#{top_track}`)")
      summary("Merge sem bump de versão (servidor, docs, CI) ou republicação de um commit já enviado. Na Play: #{listing}.")
    else
      UI.user_error!(
        "versionCode #{code} do pubspec é MENOR que o #{top} que a Play já tem " \
        "na faixa #{top_track} (#{listing}). Duas entregas pegaram o mesmo " \
        "bump, ou um bundle subiu à mão: suba o pubspec para acima de #{top} " \
        "(as DUAS metades + Env.appVersion) num PR novo."
      )
    end
  end

  # Upload the prod AAB to Internal testing, released to the tester list at
  # once: Internal has no Google review per release, so it is minutes from
  # merge to the owner's phone. Nothing else is touched — no listing, no
  # images, no release notes (those are required at PROMOTION, owner
  # 22/09/2026, and ride that lane).
  desc "Upload the prod AAB to the Internal testing track"
  lane :beta do |options|
    aab = File.expand_path(options[:aab].to_s, File.expand_path("..", __dir__))
    UI.user_error!("AAB not found at #{aab}") unless File.file?(aab)

    upload_to_play_store(
      package_name: PLAY_PACKAGE,
      track: "internal",
      release_status: "completed",
      aab: aab,
      json_key_data: play_key,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  # Production, only ever from here, and only through the `play-promote`
  # workflow — whose job sits behind the `play-production` Environment, so it
  # runs after the OWNER approves it (owner, 22/09/2026). Nothing is rebuilt:
  # the exact binary the testers had on Internal is the one users get.
  #
  #   action:promote  version_code:<n, blank = what Internal holds> fraction:<0..1]
  #       Internal → Production at that fraction (< 1 is a staged rollout,
  #       1 is everyone), with the release notes of that versionCode. Also the
  #       way to RESUME after a halt: supply's rollout update only finds a
  #       release that is in progress, and promoting again replaces the halted
  #       one — usually with the fixed build Internal holds by then.
  #   action:rollout  version_code:<n> fraction:<0..1]
  #       move a staged rollout already in Production (1 completes it).
  #   action:halt     version_code:<n> fraction:<the current one>
  #       stop a staged rollout where it is. Play keeps the fraction on a halted
  #       release, so it has to be the one that is live.
  #
  # dry_run:true validates the whole edit with Play and commits nothing.
  desc "Promote a versionCode from Internal testing to Production, or steer its rollout"
  lane :promote do |options|
    action = options[:action].to_s
    fraction = options[:fraction].to_s.empty? ? nil : Float(options[:fraction].to_s)
    dry_run = options[:dry_run].to_s == "true"
    unless fraction.nil? || (fraction > 0 && fraction <= 1)
      UI.user_error!("fraction must be in (0, 1] — got #{fraction}")
    end

    code = options[:version_code].to_s.strip
    if code.empty?
      UI.user_error!("#{action} needs an explicit version_code") unless action == "promote"
      on_internal = google_play_track_version_codes(
        package_name: PLAY_PACKAGE, track: "internal", json_key_data: play_key
      )
      UI.user_error!("Internal testing holds no build to promote") if on_internal.empty?
      code = on_internal.max.to_s
    end
    code = Integer(code, 10)

    common = {
      package_name: PLAY_PACKAGE,
      json_key_data: play_key,
      version_code: code,
      validate_only: dry_run,
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    }

    case action
    when "promote"
      UI.user_error!("promote needs a fraction") if fraction.nil?
      notes = release_notes_metadata(code)
      live = google_play_track_version_codes(
        package_name: PLAY_PACKAGE, track: "production", json_key_data: play_key
      ).max || 0
      if code <= live
        UI.user_error!(
          "versionCode #{code} is not newer than the #{live} already in " \
          "Production — nothing to promote. To move a rollout that is already " \
          "there, dispatch action=rollout."
        )
      end
      upload_to_play_store(
        **common,
        track: "internal",
        track_promote_to: "production",
        track_promote_release_status: "completed",
        rollout: fraction.to_s,
        skip_upload_changelogs: false,
        metadata_path: notes,
        # supply attaches release notes only to the version codes it was
        # handed; a promote uploads no binary, so the code is handed here. It
        # does NOT retain anything in the promote path — read in supply's
        # uploader (2.240.1, `perform_upload`).
        version_codes_to_retain: [code]
      )
      summary(
        "### Android: `#{code}` #{dry_run ? 'VALIDADO (dry run) para' : 'promovido à'} " \
        "Production — #{(fraction * 100).round(1)}% dos usuários"
      )
    when "rollout", "halt"
      UI.user_error!("#{action} needs the fraction") if fraction.nil?
      upload_to_play_store(
        **common,
        track: "production",
        rollout: fraction.to_s,
        release_status: action == "halt" ? "halted" : "inProgress",
        skip_upload_changelogs: true
      )
      verb = action == "halt" ? "PAUSADO em" : "rollout em"
      summary(
        "### Android: `#{code}` na Production — #{dry_run ? '(dry run) ' : ''}" \
        "#{verb} #{(fraction * 100).round(1)}%"
      )
    else
      UI.user_error!("action must be promote, rollout or halt — got '#{action}'")
    end
  end

  # The Main store listing, from `store/` — only through the `play-listing`
  # workflow, behind the owner's approval on `play-production` (T-98, owner
  # 02/10/2026). Name, short and full description in both languages, every
  # time; phone screenshots only with `upload_screenshots:true`.
  #
  #   dry_run:true             Play validates the whole edit, nothing commits.
  #   upload_screenshots:true  each language's phone set is REPLACED by
  #                            store/screenshots/<lang>/phone-<n>.png, in that
  #                            order; a language with no folder keeps what Play
  #                            has. Off (the default), no image is touched.
  #
  # Nothing else moves: no binary, no track, no release notes, no icon, no
  # feature graphic, no contact details (supply 2.240.1 writes only
  # title/short/full — `video` stays, read back from Play — plus the image
  # types that have files in the scratch folder).
  desc "Publish the store listing (and, if asked, the phone screenshots) from store/"
  lane :listing do |options|
    dry_run = options[:dry_run].to_s == "true"
    screenshots = options[:upload_screenshots].to_s == "true"

    metadata = Dir.mktmpdir("listing-")
    sent_shots = {}
    lengths = []
    LISTING_LANGUAGES.each do |lang|
      dir = File.join(metadata, lang)
      FileUtils.mkdir_p(dir)
      listing_fields(lang).each do |field, text|
        File.write(File.join(dir, "#{field}.txt"), text)
        lengths << "- `#{lang}` #{field}: #{text.length} caracteres"
      end
      next unless screenshots

      shots = phone_screenshots(lang)
      next if shots.empty?

      # supply uploads a type's files in name order; a two-digit name keeps
      # the numeric order phone_screenshots already settled.
      phone = File.join(dir, "images", "phoneScreenshots")
      FileUtils.mkdir_p(phone)
      shots.each_with_index do |src, i|
        FileUtils.cp(src, File.join(phone, format("%02d.png", i + 1)))
      end
      sent_shots[lang] = shots.size
    end
    if screenshots && sent_shots.empty?
      UI.user_error!(
        "upload_screenshots:true, but store/screenshots/<lang>/ holds no " \
        "phone-<n>.png in any language — nothing to send."
      )
    end

    # supply hangs every metadata upload on ONE release of `track` (even with
    # changelogs skipped it refuses "Could not find release for version code"
    # without one — `perform_upload_meta`, 2.240.1). Internal always holds
    # the latest build (T-79); naming its code picks exactly one release, and
    # with no binary, no promote and no rollout the track itself is only READ.
    anchor = google_play_track_version_codes(
      package_name: PLAY_PACKAGE, track: "internal", json_key_data: play_key
    ).max
    UI.user_error!("Internal testing holds no build to anchor the edit on") if anchor.nil?

    upload_to_play_store(
      package_name: PLAY_PACKAGE,
      json_key_data: play_key,
      track: "internal",
      version_code: anchor,
      metadata_path: metadata,
      validate_only: dry_run,
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_metadata: false,
      skip_upload_screenshots: !screenshots,
      # With screenshots on: a remote image that is not the local one at the
      # same position is DELETED, an identical prefix is kept, the rest goes
      # up — the phone set ends up exactly the local one (supply's
      # `upload_screenshots`). Only types with local files are touched.
      sync_image_upload: true
    )

    shots_line = if !screenshots
                   "capturas não tocadas"
                 else
                   sent_shots.map { |lang, n| "#{n} capturas `#{lang}`" }.join(", ")
                 end
    summary(
      "### Ficha da Play: #{dry_run ? 'VALIDADA (dry run), nada publicado' : 'ENVIADA ao Google para revisão'} " \
      "— nome e descrições em #{LISTING_LANGUAGES.join(' e ')}; #{shots_line}"
    )
    lengths.each { |line| summary(line) }
  end

  # A PR's dev APK on the owner's phone, through Firebase App Distribution on
  # the DEV project — the build a PR is tested with BEFORE the merge (QA
  # happens before `main`, §4). The dev flavour (`com.entrelares.flutter`,
  # "Entrelares Dev") against the dev database, installed beside the store
  # app. The second caregiver of a two-account test signs in on the PR's QA
  # web deploy, not in a second APK (owner, 22/09/2026).
  desc "Distribute a PR's dev APK through Firebase App Distribution"
  lane :preview do |options|
    apk = File.expand_path(options[:apk].to_s, File.expand_path("..", __dir__))
    UI.user_error!("APK not found at #{apk}") unless File.file?(apk)
    credential = ENV["FIREBASE_APP_DISTRIBUTION_SERVICE_ACCOUNT"].to_s
    UI.user_error!("FIREBASE_APP_DISTRIBUTION_SERVICE_ACCOUNT is empty") if credential.strip.empty?

    firebase_app_distribution(
      app: FIREBASE_DEV_ANDROID_APP,
      android_artifact_type: "APK",
      android_artifact_path: apk,
      groups: QA_TESTER_GROUP,
      release_notes: options[:notes].to_s,
      service_credentials_json_data: credential
    )
  end
end
